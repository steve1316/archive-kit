{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",

		// Load-bearing, do not add "vite/client" here. An empty list keeps every ambient @types package out of the program, which is what makes `import.meta.env`
		// and `import.meta.glob` hard errors rather than silently available. React and MUI types arrive through the import graph instead, so nothing is lost.
		"types": [],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"]
}
