{
	"name": "archive-kit",
	"version": "0.7.0",
	"description": "The shared front-end framework behind a family of static game-archive sites.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steve1316/archive-kit.git"
	},
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@12.3.4",
	"files": [
		"dist",
		"src",
		"presets",
		"tsconfig.base.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js"
		},
		"./tsconfig.base.json": "./tsconfig.base.json",
		"./presets/*": "./presets/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"prepare": "pnpm build",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router-dom": "^7.18.3"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prettier": "^3.9.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router-dom": "^7.18.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
