{
	// Base config for an archive app. Extend it and add your own `include`:
	//     { "extends": "archive-kit/tsconfig.base.json", "include": ["src"] }
	// This is the app-side config, so unlike the kit's own tsconfig it keeps `vite/client` and the two macros that come with it.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client"],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"allowJs": false,
		"checkJs": false,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true
	}
}
